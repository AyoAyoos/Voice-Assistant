# Copy to .env and set your Gemini API key.
GEMINI_API_KEY=your-gemini-api-key

# Active Live API model. Supported endpoints:
# gemini-3-flash-preview
# gemini-3.1-flash-live-preview
# gemini-3.5-live-translate-preview
# gemini-3.5-transcribe-live
# gemini-3.8-live
# gemini-3.8-live-extended-thinking
GEMINI_LIVE_MODEL=gemini-3.8-live

GEMINI_VOICE=Puck
GEMINI_LANGUAGE=en-US

# Seconds of user silence before one idle prompt, then before goodbye/end.
IDLE_PROMPT_SECONDS=15
IDLE_END_SECONDS=10

HOST=127.0.0.1
# Rare, non-dynamic port for this project. Reserve 45120-45125 for other local projects.
PORT=45123

# Assistant tools. Keep API keys backend-side only; never send them to the browser.
# Tavily powers web_search and fetch_page (clean, LLM-friendly snippets).
TAVILY_API_KEY=your-tavily-api-key
# Optional fallback used only when a Tavily call fails. Leave empty to disable.
BRAVE_API_KEY=

# Backend selection:
#   auto   - use Gemini Live when reachable, otherwise local models (recommended)
#   gemini - Gemini Live only; fail if unreachable
#   local  - always use local STT + LLM + TTS (Ollama, faster-whisper, Piper)
VOICE_BACKEND=auto

# Offline local models. Pull the chat model and download the STT/TTS assets once.
#   ollama pull qwen2.5:3b-instruct
# See SETUP.md for Whisper and Piper download commands.
LOCAL_STT_MODEL=small.en
# CPU threads for local Whisper. Lower this if the model fails to load with
# "mkl_malloc: failed to allocate memory" on a memory-constrained machine.
LOCAL_STT_NUM_THREADS=2
LOCAL_LLM_MODEL=qwen2.5:3b-instruct
# Sampling temperature for the local fallback chat model. Higher is more varied.
LOCAL_LLM_TEMPERATURE=0.7
LOCAL_TTS_VOICE=en_US-lessac-medium
# Directory holding Piper voices (default: ~/.cache/piper)
PIPER_MODELS_DIR=

# Local persistence and embeddings (all optional; defaults shown).
VOICE_DB_PATH=data/voice_assistant.duckdb
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
EMBEDDING_DIM=768
OLLAMA_TIMEOUT_SECONDS=10

# Post-call memory distillation. gemini-flash-lite-latest is fast and reliable.
MEMORY_MODEL=gemini-flash-lite-latest
MEMORY_EXTRACTION_TIMEOUT_SECONDS=15
MEMORY_DEDUPE_THRESHOLD=0.93
MEMORY_CONTEXT_LIMIT=20
CONTEXT_TURN_LIMIT=20

# Caching / cold-start tuning.
CONTEXT_CACHE_TTL_SECONDS=300
EMBEDDING_CACHE_MAX_ENTRIES=512
EMBEDDING_CACHE_TTL_SECONDS=3600
NETWORK_WAIT_SECONDS=10

# OpenCode bridge (uses the already-running service; starts no new agent).
# The service password is backend-only. Leave it empty to read the local
# ~/.config/opencode/service.json file. Never paste it into docs or chat.
OPENCODE_BASE_URL=http://127.0.0.1:28894
OPENCODE_SERVICE_PASSWORD=
OPENCODE_PROJECT_DIR=D:\voice-assistant
# Must be OUTSIDE OPENCODE_PROJECT_DIR so the live checkout is never edited.
OPENCODE_WORKTREE_ROOT=D:\voice-assistant-worktrees
# Seconds to wait inside a voice turn before returning "still running".
OPENCODE_TASK_WAIT_SECONDS=45
# Total background wait before a task is marked finished/timed out.
OPENCODE_TASK_TIMEOUT_SECONDS=300
# Default reject when the user does not answer a spoken approval question.
OPENCODE_APPROVAL_TIMEOUT_SECONDS=60
